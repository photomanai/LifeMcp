# Secret key to use when connecting to the server (generate a random value yourself)
MCP_API_KEY=change_this_to_a_strong_random_key
PORT=9898

# --- Gmail (App Password ile SMTP/IMAP) ---
# 2FA (Two-Factor Authentication) must be enabled in your Google account.
# To create an App Password: myaccount.google.com/apppasswords
GMAIL_USER=ornek@gmail.com
GMAIL_APP_PASSWORD=

# --- Telegram (create a free bot via BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion (create a free integration at notion.so/my-integrations) ---
NOTION_API_KEY=
NOTION_DATABASE_ID=

# --- WhatsApp (Baileys - QR code scanned in terminal, no .env needed) ---
# Scan the QR code on first use with your phone.
# Automatically saved to whatsapp-session/ folder.
